# Backend configuration
DB_HOST=localhost  # 👉 Palitan mo ito kung naka-host ang database mo online (e.g. AWS, Railway, etc.)
DB_PORT=3306
DB_USER=root
DB_PASSWORD=dominador_orpilla_15
DB_DATABASE=report_tracking
SECRET_KEY=replace_with_a_strong_secret
TOKEN_MAX_AGE=28800

# Frontend URL for emails and redirects
# Use your computer's local network IP when opening links on a phone.
# Example: FRONTEND_URL=http://192.168.1.55:3000
FRONTEND_URL=http://localhost:3000

# Email settings for Brevo (Sendinblue)
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=your@company.com
BREVO_SENDER_NAME=Report Tracking System

# SMTP fallback settings (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=your@company.com
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# Google Sign-In verification
GOOGLE_CLIENT_ID=your-google-client-id
# Optional: comma-separated list if you support multiple Google web clients
GOOGLE_CLIENT_IDS=
